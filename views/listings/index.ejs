<% layout('layouts/boilerplate') %>

<h3>All Listings</h3>

<div 
class="row row-cols-lg-3 
          row-cols-md-3
              row-col-sm-1">
    <% for(let listing of allListing){ %>
        <a 
             href="/listings/<%= listing._id %>" 
               class="listing-link">
                  <div class="card col listing-card" 
                     style="border:none;
                         margin-bottom: 2rem;">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://plus.unsplash.com/premium_photo-1748894837513-e52e18135365?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0' %>"
                      class="card-img-top"
                         alt="listing_image" 
                            style="height:20rem">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %> <br></b>
                        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price not available" %> /night
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>
